		"\nLastPocketTeam1: %u"
		, matchState.Seed
		, matchState.TimeStart
		, (float)matchState.TotalSeconds
		, ::gpk::get_value_namep(matchState.Mode)
		, matchState.CountBalls
		, (int)matchState.TeamInfo.LastPocketTeam0
