	struct STown {
		::gpk::vcc				Name;
		uint32_t				Country;

		::gpk::error_t			Save				(::gpk::au8 & output)	const	{ 
			gpk_necs(::gpk::saveView(output, Name)); 
			gpk_necs(::gpk::savePOD (output, Country)); 
			return 0;
